      "id": "bafdd901-2c29-4749-8f6c-69c771fec75b",
      "name": "Prepare Material for Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -80
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert educational assessment generator.\n\nAnalyze the provided educational material, identify all the lessons or sections contained within it, and generate multiple-choice questions for each detected lesson.\n\nQUESTION DISTRIBUTION PER LESSON:\n- For each lesson found in the material, generate exactly 30 questions.\n- Cover different concepts and sections of each lesson thoroughly.\n\nQUESTION REQUIREMENTS:\n- Each question must be based ONLY on the provided educational material.\n- Do not introduce information that is not supported by the source.\n- Each question must have exactly four options: A, B, C, and D.\n- Exactly one option must be correct.\n- The incorrect options must be plausible but clearly incorrect according to the source.\n- Avoid duplicate or substantially repeated questions.\n- Preserve the exact title, naming, and terminology used in the source material for each lesson.\n\nOUTPUT FORMAT:\nReturn ONLY valid JSON.\nDo not add Markdown (no ```json or ```).\nDo not add explanations before or after the JSON.\n\nUse exactly this JSON structure:\n\n{\n  \"lessons\": [\n    {\n      \"lesson\": \"Exact Lesson Name and Number from the Source\",\n      \"questions\": [\n        {\n          \"question\": \"...\",\n          \"optionA\": \"...\",\n          \"optionB\": \"...\",\n          \"optionC\": \"...\",\n          \"optionD\": \"...\",\n          \"correctAnswer\": \"A\"\n        }\n      ]\n    }\n  ]\n}\n\nIMPORTANT VERIFICATION BEFORE OUTPUT:\n- Each detected lesson must contain exactly 30 questions.\n- Every question has optionA, optionB, optionC, optionD.\n- Every correctAnswer is exactly one of A, B, C, or D.\n- No question is missing any required field.\n\nEDUCATIONAL MATERIAL:\n\n{{ $json.material }}",
        "batching": {}
      },
      "id": "1f59818f-84da-4362-af88-f24234c6b8b6",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1184,
        -80
      ],
      "retryOnFail": false,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet rawText = input.text || '';\n\nrawText = rawText\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst start = rawText.indexOf('{');\nconst end = rawText.lastIndexOf('}');\nif (start === -1 || end === -1) {\n  throw new Error('Valid JSON boundaries { } not found in Gemini response.');\n}\n\nlet jsonText = rawText.substring(start, end + 1);\n\njsonText = jsonText\n  .replace(/,\\s*([}\\\\]])/g, '$1')\n  .replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, \"\");\n\nlet data;\ntry {\n  data = JSON.parse(jsonText);\n} catch (error) {\n  try {\n    let fixedText = jsonText.trim();\n    if (!fixedText.endsWith(']}')) {\n      fixedText += ']}';\n    }\n    data = JSON.parse(fixedText);\n  } catch (e2) {\n    throw new Error(`Failed to parse JSON even after auto-repair: ${error.message}`);\n  }\n}\n\nif (!data.lessons || !Array.isArray(data.lessons)) {\n  throw new Error('Gemini response does not contain a valid lessons array.');\n}\n\nconst output = [];\n\ndata.lessons.forEach((lesson, index) => {\n  if (!lesson.questions || !Array.isArray(lesson.questions)) return;\n  \n  const lessonName = lesson.lesson || `Lesson 1-${index + 1}`;\n\n  lesson.questions.forEach((q) => {\n    if (q.question && q.optionA && q.optionB && q.optionC && q.optionD && q.correctAnswer) {\n      let correctText = '';\n      const ans = q.correctAnswer.trim().toUpperCase();\n      if (ans === 'A') correctText = q.optionA;\n      else if (ans === 'B') correctText = q.optionB;\n      else if (ans === 'C') correctText = q.optionC;\n      else if (ans === 'D') correctText = q.optionD;\n      else correctText = q.correctAnswer;\n\n      output.push({\n        json: {\n          'exam name': lessonName,\n          'Question': q.question,\n          'Option A': q.optionA,\n          'Option B': q.optionB,\n          'Option C': q.optionC,\n          'Option D': q.optionD,\n          'Correct Answer': correctText\n        }\n      });\n    }\n  });\n});\n\nif (output.length === 0) {\n  throw new Error('Parsed 0 valid questions from the Gemini output.');\n}\n\nreturn output;"
      },
