    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst groupedExams = {};\n\nrows.forEach(row => {\n  const examName = row.json[\"exam name\"] || row.json[\"اسم الاختبار\"] || row.json[\"examName\"] || \"اختبار بدون عنوان\";\n  if (!groupedExams[examName]) {\n    groupedExams[examName] = [];\n  }\n  groupedExams[examName].push(row.json);\n});\n\nreturn Object.keys(groupedExams).map(examName => ({\n  json: {\n    examName: examName,\n    questions: groupedExams[examName]\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        -48
      ],
      "id": "fce8a627-6903-4d92-8a8c-b603278765ae",
      "name": "Group By Exam Name"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://forms.googleapis.com/v1/forms",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"info\": {\n    \"title\": \"{{ $json.examName }}\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
