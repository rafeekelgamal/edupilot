      "id": "325c5ae5-e53e-49f7-a73d-849360141612",
      "name": "Create Form",
      "credentials": {
        "oAuth2Api": {
          "id": "fNMAEdsbLmNAj1Om",
          "name": "Unnamed credential"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, itemIndex) => {\n  const examGroup =$(\"Group By Exam Name\").all()[itemIndex];\n  const questions = (examGroup && examGroup.json && examGroup.json.questions) ? examGroup.json.questions : [];\n  const formId = item.json.formId;\n  const examName = examGroup.json.examName;\n\n  const quizSettingRequest = {\n    updateSettings: {\n      settings: {\n        quizSettings: {\n          isQuiz: true\n        }\n      },\n      updateMask: \"quizSettings.isQuiz\"\n    }\n  };\n\n  const updateInfoRequest = {\n    updateFormInfo: {\n      info: {\n        description: \"Exam Name: \" + examName\n      },\n      updateMask: \"description\"\n    }\n  };\n\n  const emailItemRequest = {\n    createItem: {\n      item: {\n        title: \"البريد الإلكتروني\",\n        questionItem: {\n          question: {\n            required: true,\n            textQuestion: {\n              paragraph: false\n            }\n          }\n        }\n      },\n      location: {\n        index: 0\n      }\n    }\n  };\n\n  const createItemRequests = questions.map((q, index) => {\n    const questionTitle = q[\"Question\"] || q[\"السؤال\"] || `سؤال ${index + 1}`;\n    \n    const rawOptions = [\n      q[\"Option A\"] || q[\"الخيار الأول\"],\n      q[\"Option B\"] || q[\"الخيار الثاني\"],\n      q[\"Option C\"] || q[\"الخيار الثالث\"],\n      q[\"Option D\"] || q[\"الخيار الرابع\"]\n    ].filter(opt => opt !== undefined && opt !== null && String(opt).trim() !== \"\");\n\n    const correctAnswer = String(q[\"Correct Answer\"] || q[\"الإجابة الصحيحة\"] || q[\"Answer\"] || \"\").trim();\n\n    const questionObj = {\n      required: true,\n      choiceQuestion: {\n        type: \"RADIO\",\n        options: rawOptions.map(opt => ({ value: String(opt) }))\n      }\n    };\n\n    if (correctAnswer) {\n      questionObj.grading = {\n        pointValue: 1,\n        correctAnswers: {\n          answers: [\n            { value: correctAnswer }\n          ]\n        }\n      };\n    }\n\n    return {\n      createItem: {\n        item: {\n          title: String(questionTitle),\n          questionItem: {\n            question: questionObj\n          }\n        },\n        location: {\n          index: index + 1\n        }\n      }\n    };\n  });\n\n  return {\n    json: {\n      formId: formId,\n      examName: examName,\n      payload: {\n        requests: [quizSettingRequest, updateInfoRequest, emailItemRequest, ...createItemRequests]\n      }\n    }\n  };\n});"
      },
