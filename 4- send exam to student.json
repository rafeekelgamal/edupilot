    {
      "parameters": {
        "jsCode": "const sentFormIds = new Set();\nconst items = $('Combine Data & Build HTML').all();\n\nitems.forEach(item => {\n    if (item.json.sent_form_ids) {\n        item.json.sent_form_ids.forEach(id => sentFormIds.add(id));\n    }\n});\n\nreturn Array.from(sentFormIds).map(formId => ({\n    json: {\n        formId: formId,\n        send: 'ok'\n    }\n}));"
      },
