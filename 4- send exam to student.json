    {
      "parameters": {
        "jsCode": "// 1. فلترة الطلاب\nconst students = $('Get students sheet').all().filter(s => {\n    const email = s.json.email || s.json['الإيميل'] || s.json['Email'];\n    return email && email.trim() !== '';\n});\n\n// 2. تجميع الامتحانات التي لم تُرسل (التي لا تحتوي على ok)\nconst rawExams = $('Get forms sheet').all();\nconst uniqueExamsMap = new Map();\n\nrawExams.forEach(exam => {\n    const row = exam.json;\n    const formId = row.formId || row.form_id || row['Form ID'] || row.id || row.ID;\n    const examName = row['exam name'] || row.exam_name || row['examName'] || row['اسم الامتحان'] || row['Name'] || 'امتحان بدون اسم';\n    const sendStatus = row.send || row.Send;\n\n    if (formId && sendStatus !== 'ok' && !uniqueExamsMap.has(formId)) {\n        uniqueExamsMap.set(formId, examName);\n    }\n});\n\nif (uniqueExamsMap.size === 0) return [];\n\n// 3. بناء روابط الـ HTML وتجميع IDs الامتحانات\nlet examsHtml = '';\nconst sentFormIds = [];\nuniqueExamsMap.forEach((examName, formId) => {\n    const formUrl = `https://docs.google.com/forms/d/${formId}/viewform`;\n    examsHtml += `<li><a href=\"${formUrl}\" target=\"_blank\">${examName}</a></li>`;\n    sentFormIds.push(formId);\n});\n\n// 4. إرجاع البيانات لكل طالب\nreturn students.map(student => {\n    const sRow = student.json;\n    const studentName = sRow.name || sRow['الاسم'] || sRow['Student Name'] || 'طالبنا العزيز';\n    const studentEmail = sRow.email || sRow['الإيميل'] || sRow['Email'];\n    \n    const fullHtmlEmail = `<p>مرحباً ${studentName}،</p><p>إليك قائمة الامتحانات الخاصة بك:</p><ul>${examsHtml}</ul><p>بالتوفيق والنجاح!</p>`;\n\n    return {\n        json: {\n            student_email: studentEmail,\n            email_body: fullHtmlEmail,\n            sent_form_ids: sentFormIds\n        }\n    };\n});"
      },
