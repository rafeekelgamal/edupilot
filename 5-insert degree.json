    {
      "parameters": {
        "jsCode": "const existingLogs = $(\"Read Existing Log1\").all().map(item => item.json);\n\nconst normalize = value => (value ?? \"\").toString().trim().toLowerCase();\nconst normalizeTitle = value => normalize(value)\n  .normalize(\"NFKC\")\n  .replace(/[إأآ]/g, \"ا\")\n  .replace(/[\\u064B-\\u065F\\u0670]/g, \"\")\n  .replace(/\\s+/g, \" \");\n\nconst isEmailQuestionTitle = title => {\n  const t = normalizeTitle(title);\n  return t === \"البريد الالكتروني\" || t === \"البريد الإلكتروني\";\n};\n\nconst existingKeys = new Set(existingLogs.map(log => {\n  const exam = normalize(log[\"exam name\"] || log[\"اسم الاختبار\"]);\n  const email = normalize(log[\"email\"] || log[\"البريد الالكتروني\"]);\n  const degree = log[\"total degree\"] !== undefined && log[\"total degree\"] !== null\n    ? log[\"total degree\"].toString().trim()\n    : \"\";\n  return `${exam}_${email}_${degree}`;\n}));\n\nconst activeForms = $(\"Get Active Form IDs1\").all();\nconst httpResponses = $(\"Get Dynamic Responses1\").all();\nconst formMetadata = $(\"Get Form Metadata1\").all();\nconst finalItems = [];\n\nhttpResponses.forEach((httpItem, idx) => {\n  const examInfo = activeForms[idx]?.json || {};\n  const metadata = formMetadata[idx]?.json || {};\n  const examName = examInfo[\"exam name\"] || examInfo[\"اسم الاختبار\"] || \"اختبار بدون عنوان\";\n  const responsesList = httpItem.json?.responses || [];\n\n  const emailQuestionIds = new Set();\n  for (const item of (metadata.items || [])) {\n    if (!isEmailQuestionTitle(item.title)) continue;\n    const questionId = item.questionItem?.question?.questionId;\n    if (questionId) emailQuestionIds.add(questionId);\n    for (const q of (item.questionGroupItem?.questions || [])) {\n      if (q.questionId) emailQuestionIds.add(q.questionId);\n    }\n  }\n\n  responsesList.forEach(r => {\n    let totalScore = 0;\n    const answers = r.answers || {};\n    Object.values(answers).forEach(ans => {\n      if (ans.grade && typeof ans.grade.score === \"number\") totalScore += ans.grade.score;\n    });\n\n    let email = \"\";\n    for (const questionId of emailQuestionIds) {\n      const answer = answers[questionId];\n      const value = (answer?.textAnswers?.answers || [])\n        .map(a => (a.value || \"\").toString().trim())\n        .find(Boolean) || \"\";\n      if (value) {\n        email = value; // جلب الإجابة كما هي تماماً بدون فلترة أو فالديشن\n        break;\n      }\n    }\n\n    if (!email) return;\n\n    const uniqueKey = `${normalize(examName)}_${normalize(email)}_${totalScore}`;\n    if (!existingKeys.has(uniqueKey)) {\n      finalItems.push({ json: { \"exam name\": examName, \"email\": email, \"total degree\": totalScore, \"send\": \"\" } });\n      existingKeys.add(uniqueKey);\n    }\n  });\n});\n\nreturn finalItems;"
      },
